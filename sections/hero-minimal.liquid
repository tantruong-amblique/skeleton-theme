{% comment %}
  Hero Section - Minimal
  Clean, text-focused hero with customizable CTA buttons
  
  Features:
  - Responsive typography system
  - Customizable colors and alignment
  - Primary and secondary CTAs
  - Background options
  - Dark mode compatibility
  - Performance optimized
{% endcomment %}

{% liquid
  assign section_bg = section.settings.background_color | default: 'transparent'
  assign text_alignment = section.settings.text_alignment | default: 'center'
  assign section_padding = section.settings.section_padding | default: 16
  assign max_width = section.settings.content_width | default: 'max-w-4xl'
  assign heading_size = section.settings.heading_size | default: 'text-4xl'
  assign subtitle_size = section.settings.subtitle_size | default: 'text-lg'
  
  # Layout settings
  assign section_width = section.settings.section_width | default: 'full'
  assign padding_top = section.settings.padding_top | default: 0
  assign padding_right = section.settings.padding_right | default: 0
  assign padding_bottom = section.settings.padding_bottom | default: 0
  assign padding_left = section.settings.padding_left | default: 0
%}

<section 
  class="hero-minimal py-{{ section_padding }} relative overflow-hidden {% if section_width == 'full' %}full-width{% else %}max-w-7xl mx-auto{% endif %}"
  style="
    {% if section_bg != 'transparent' %}background-color: {{ section_bg }};{% endif %}
    padding-top: {{ padding_top }}px;
    padding-right: {{ padding_right }}px;
    padding-bottom: {{ padding_bottom }}px;
    padding-left: {{ padding_left }}px;
  "
  role="banner"
  aria-label="Hero section"
>
  {% comment %} Background pattern overlay {% endcomment %}
  {% if section.settings.show_pattern %}
    <div class="absolute inset-0 opacity-5">
      <div class="absolute inset-0 bg-gradient-to-br from-primary/20 via-transparent to-secondary/20"></div>
    </div>
  {% endif %}

  <div class="relative z-10">
    <div class="mx-auto px-4 {{ max_width }}">
      <div class="space-y-6 text-{{ text_alignment }}">
      
        {% comment %} Main Heading {% endcomment %}
        {% if section.settings.heading != blank %}
          <h1 class="text-2xl sm:text-3xl md:{{ heading_size }} lg:{{ heading_size | replace: 'text-', 'text-' | append: 'xl' }} font-bold leading-tight text-base-content">
            {{ section.settings.heading | escape }}
          </h1>
        {% endif %}

        {% comment %} Subtitle {% endcomment %}
        {% if section.settings.subtitle != blank %}
          <div class="text-base sm:{{ subtitle_size }} md:text-xl text-base-content/80 leading-relaxed">
            {{ section.settings.subtitle | newline_to_br }}
          </div>
        {% endif %}

        {% comment %} CTA Buttons {% endcomment %}
        {% if section.settings.cta_primary_text != blank or section.settings.cta_secondary_text != blank %}
          <div class="flex flex-wrap gap-4 {% if text_alignment == 'center' %}justify-center{% elsif text_alignment == 'right' %}justify-end{% else %}justify-start{% endif %} pt-2">
          
          {% comment %} Primary CTA {% endcomment %}
          {% if section.settings.cta_primary_text != blank %}
            <a 
              href="{{ section.settings.cta_primary_url | default: '#' }}"
              class="btn btn-{{ section.settings.cta_primary_color | default: 'primary' }} btn-{{ section.settings.button_size | default: 'lg' }} {{ section.settings.cta_primary_style }}"
              {% if section.settings.cta_primary_url contains 'http' %}target="_blank" rel="noopener"{% endif %}
              aria-label="{{ section.settings.cta_primary_text | escape }}"
            >
              {% if section.settings.cta_primary_icon %}
                {{ section.settings.cta_primary_icon | inline_asset_content }}
              {% endif %}
              {{ section.settings.cta_primary_text | escape }}
            </a>
          {% endif %}

          {% comment %} Secondary CTA {% endcomment %}
          {% if section.settings.cta_secondary_text != blank %}
            <a 
              href="{{ section.settings.cta_secondary_url | default: '#' }}"
              class="btn btn-{{ section.settings.cta_secondary_color | default: 'outline' }} btn-{{ section.settings.button_size | default: 'lg' }} {{ section.settings.cta_secondary_style }}"
              {% if section.settings.cta_secondary_url contains 'http' %}target="_blank" rel="noopener"{% endif %}
              aria-label="{{ section.settings.cta_secondary_text | escape }}"
            >
              {% if section.settings.cta_secondary_icon %}
                {{ section.settings.cta_secondary_icon | inline_asset_content }}
              {% endif %}
              {{ section.settings.cta_secondary_text | escape }}
            </a>
          {% endif %}
        </div>
      {% endif %}

        {% comment %} Trust indicators {% endcomment %}
        {% if section.settings.show_trust_indicators and section.blocks.size > 0 %}
          <div class="pt-8 border-t border-base-content/10">
            <div class="flex flex-wrap items-center gap-6 {% if text_alignment == 'center' %}justify-center{% elsif text_alignment == 'right' %}justify-end{% else %}justify-start{% endif %}">
              {% for block in section.blocks %}
                {% case block.type %}
                  {% when 'trust_badge' %}
                    <div class="trust-badge opacity-60 hover:opacity-100 transition-opacity">
                      {% if block.settings.image %}
                        <img 
                          src="{{ block.settings.image | image_url: width: 120 }}"
                          alt="{{ block.settings.alt_text | default: block.settings.text | escape }}"
                          class="h-8 w-auto"
                          width="120"
                          height="32"
                          loading="lazy"
                        >
                      {% elsif block.settings.text != blank %}
                        <span class="text-sm text-base-content/60 font-medium">{{ block.settings.text }}</span>
                      {% else %}
                        <div class="flex items-center gap-2 px-3 py-1 bg-primary/10 rounded-full border border-primary/20">
                          <svg class="w-4 h-4 text-primary" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                          </svg>
                          <span class="text-sm text-primary font-medium">Trusted</span>
                        </div>
                      {% endif %}
                    </div>
                  {% when 'stat' %}
                    <div class="stat-item text-center">
                      <div class="text-2xl font-bold text-primary">{{ block.settings.number }}</div>
                      <div class="text-xs text-base-content/60 uppercase tracking-wide">{{ block.settings.label }}</div>
                    </div>
                {% endcase %}
              {% endfor %}
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  {% comment %} Scroll indicator {% endcomment %}
  {% if section.settings.show_scroll_indicator %}
    <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-base-content/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </div>
  {% endif %}
</section>

{% comment %} Schema-optimized structured data {% endcomment %}
{% if section.settings.heading != blank %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPageElement",
    "name": "Hero Section",
    "headline": {{ section.settings.heading | json }},
    "description": {{ section.settings.subtitle | json }},
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "{{ shop.url }}{{ request.path }}"
    }
  }
  </script>
{% endif %}

{% schema %}
{
  "name": "Hero - Minimal",
  "tag": "section",
  "class": "section-hero-minimal",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "options": [
        {"value": "full", "label": "Full Page"},
        {"value": "container", "label": "Container"}
      ],
      "default": "full",
      "info": "Choose between full page width or contained layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding Right", 
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding Left",
      "default": 0
    },
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Welcome to our store",
      "info": "Main hero headline - keep it impactful and under 60 characters"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Discover our amazing products and services that will transform your experience",
      "info": "Supporting text - explain your value proposition"
    },
    {
      "type": "header",
      "content": "Primary Call-to-Action"
    },
    {
      "type": "text",
      "id": "cta_primary_text",
      "label": "Primary Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary Button URL"
    },
    {
      "type": "select",
      "id": "cta_primary_color",
      "label": "Primary Button Color",
      "options": [
        {"value": "primary", "label": "Primary"},
        {"value": "secondary", "label": "Secondary"},
        {"value": "accent", "label": "Accent"},
        {"value": "neutral", "label": "Neutral"},
        {"value": "info", "label": "Info"},
        {"value": "success", "label": "Success"},
        {"value": "warning", "label": "Warning"},
        {"value": "error", "label": "Error"},
        {"value": "outline", "label": "Outline"},
        {"value": "soft", "label": "Soft"},
        {"value": "dash", "label": "Dash"},
        {"value": "ghost", "label": "Ghost"},
        {"value": "link", "label": "Link"}
      ],
      "default": "primary",
      "info": "DaisyUI button color for primary CTA"
    },
    {
      "type": "select",
      "id": "cta_primary_style",
      "label": "Primary Button Style Modifier",
      "options": [
        {"value": "", "label": "Default"},
        {"value": "btn-wide", "label": "Wide"},
        {"value": "btn-circle", "label": "Circle"}
      ],
      "default": "",
      "info": "Additional style modifiers for primary button"
    },
    {
      "type": "header",
      "content": "Secondary Call-to-Action"
    },
    {
      "type": "text",
      "id": "cta_secondary_text",
      "label": "Secondary Button Text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary Button URL"
    },
    {
      "type": "select",
      "id": "cta_secondary_color",
      "label": "Secondary Button Color",
      "options": [
        {"value": "primary", "label": "Primary"},
        {"value": "secondary", "label": "Secondary"},
        {"value": "accent", "label": "Accent"},
        {"value": "neutral", "label": "Neutral"},
        {"value": "info", "label": "Info"},
        {"value": "success", "label": "Success"},
        {"value": "warning", "label": "Warning"},
        {"value": "error", "label": "Error"},
        {"value": "outline", "label": "Outline"},
        {"value": "soft", "label": "Soft"},
        {"value": "dash", "label": "Dash"},
        {"value": "ghost", "label": "Ghost"},
        {"value": "link", "label": "Link"}
      ],
      "default": "outline",
      "info": "DaisyUI button color for secondary CTA"
    },
    {
      "type": "select",
      "id": "cta_secondary_style",
      "label": "Secondary Button Style Modifier",
      "options": [
        {"value": "", "label": "Default"},
        {"value": "btn-wide", "label": "Wide"},
        {"value": "btn-circle", "label": "Circle"}
      ],
      "default": "",
      "info": "Additional style modifiers for secondary button"
    },
    {
      "type": "header",
      "content": "Design Settings"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        {"value": "left", "label": "Left"},
        {"value": "center", "label": "Center"},
        {"value": "right", "label": "Right"}
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content Width",
      "options": [
        {"value": "max-w-2xl", "label": "Narrow"},
        {"value": "max-w-4xl", "label": "Medium"},
        {"value": "max-w-6xl", "label": "Wide"},
        {"value": "max-w-full", "label": "Full Width"}
      ],
      "default": "max-w-4xl"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "options": [
        {"value": "text-3xl", "label": "Small"},
        {"value": "text-4xl", "label": "Medium"},
        {"value": "text-5xl", "label": "Large"},
        {"value": "text-6xl", "label": "Extra Large"}
      ],
      "default": "text-4xl"
    },
    {
      "type": "select",
      "id": "subtitle_size",
      "label": "Subtitle Size",
      "options": [
        {"value": "text-base", "label": "Small"},
        {"value": "text-lg", "label": "Medium"},
        {"value": "text-xl", "label": "Large"}
      ],
      "default": "text-lg"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "Button Size",
      "options": [
        {"value": "xs", "label": "Extra Small"},
        {"value": "sm", "label": "Small"},
        {"value": "md", "label": "Medium"},
        {"value": "lg", "label": "Large"},
        {"value": "xl", "label": "Extra Large"}
      ],
      "default": "lg",
      "info": "Size of both primary and secondary buttons"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "info": "Leave empty for transparent background"
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "rem",
      "label": "Section Padding",
      "default": 16
    },
    {
      "type": "header",
      "content": "Additional Features"
    },
    {
      "type": "checkbox",
      "id": "show_pattern",
      "label": "Show Background Pattern",
      "default": false,
      "info": "Adds a subtle gradient pattern overlay"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_indicator",
      "label": "Show Scroll Indicator",
      "default": false,
      "info": "Animated arrow pointing down"
    },
    {
      "type": "checkbox",
      "id": "show_trust_indicators",
      "label": "Show Trust Indicators",
      "default": false,
      "info": "Display trust badges or statistics below content"
    }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Badge Image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Badge Text",
          "info": "Alternative to image - displays as text"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt Text",
          "info": "Accessibility description for the badge"
        }
      ]
    },
    {
      "type": "stat",
      "name": "Statistic",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "100+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Happy Customers"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero - Minimal",
      "category": "Hero",
      "blocks": [
        {
          "type": "trust_badge",
          "settings": {
            "text": "Free Shipping"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "10,000+",
            "label": "Happy Customers"
          }
        }
      ]
    }
  ]
}
{% endschema %}
