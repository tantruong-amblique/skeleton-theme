<div class="py-16 bg-base-200">
  <div class="container mx-auto px-4">
    {% if section.settings.heading != blank %}
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold text-base-content mb-4">{{ section.settings.heading }}</h2>
        {% if section.settings.description != blank %}
          <p class="text-lg text-base-content/70 max-w-2xl mx-auto">{{ section.settings.description }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="grid grid-cols-1 md:grid-cols-{{ section.settings.columns_desktop }} gap-8">
      {% for block in section.blocks %}
        <div class="card bg-base-100 shadow-xl" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            <figure class="px-10 pt-10">
              <div class="w-16 h-16 rounded-full bg-primary flex items-center justify-center">
                {{ block.settings.icon | image_url: width: 32 | image_tag: class: "w-8 h-8 invert" }}
              </div>
            </figure>
          {% endif %}
          <div class="card-body items-center text-center">
            {% if block.settings.title != blank %}
              <h3 class="card-title">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.description != blank %}
              <p>{{ block.settings.description }}</p>
            {% endif %}
            {% if block.settings.button_text != blank %}
              <div class="card-actions justify-end">
                <a href="{{ block.settings.button_url | default: '#' }}" class="btn btn-primary">
                  {{ block.settings.button_text }}
                </a>
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Features (DaisyUI)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Features"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Desktop columns",
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Feature description goes here"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Features (DaisyUI)",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Fast Performance",
            "description": "Lightning fast loading times with optimized code."
          }
        },
        {
          "type": "feature", 
          "settings": {
            "title": "Beautiful Design",
            "description": "Stunning components with DaisyUI's modern styling."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Easy Customization",
            "description": "Customize themes and components with simple settings."
          }
        }
      ]
    }
  ]
}
{% endschema %}
