{% comment %}
  Hero Section - Split Layout
  Image/content split layout with reverse option
  
  Features:
  - 50/50 split layout (desktop)
  - Stack vertically on mobile
  - Reverse layout option
  - Content alignment controls
  - Image aspect ratio control
  - Background color options
  - Performance optimized
{% endcomment %}

{% liquid
  assign reverse_layout = section.settings.reverse_layout
  assign content_alignment = section.settings.content_alignment | default: 'left'
  assign image_aspect = section.settings.image_aspect | default: 'aspect-square'
  assign content_bg = section.settings.content_background_color
  assign section_height = section.settings.section_height | default: 'min-h-screen'
  assign image_position = section.settings.image_position | default: 'object-center'
  
  # Layout settings
  assign section_width = section.settings.section_width | default: 'full'
  assign padding_top = section.settings.padding_top | default: 0
  assign padding_right = section.settings.padding_right | default: 0
  assign padding_bottom = section.settings.padding_bottom | default: 0
  assign padding_left = section.settings.padding_left | default: 0
%}

<section 
  class="hero-split {{ section_height }} relative overflow-hidden {% if section_width == 'full' %}full-width{% else %}max-w-7xl mx-auto{% endif %}"
  style="
    padding-top: {{ padding_top }}px;
    padding-right: {{ padding_right }}px;
    padding-bottom: {{ padding_bottom }}px;
    padding-left: {{ padding_left }}px;
  "
  role="banner"
  aria-label="Split hero section"
>
  <div class="grid lg:grid-cols-2 h-full {% if reverse_layout %}lg:grid-flow-col-dense{% endif %}">
    
    {% comment %} Content Side {% endcomment %}
    <div 
      class="hero-content flex items-center justify-center p-8 lg:p-16 {% if reverse_layout %}lg:col-start-2{% endif %}"
      {% if content_bg %}style="background-color: {{ content_bg }};"{% endif %}
    >
      <div class="max-w-lg w-full space-y-6 text-{{ content_alignment }}">
        
        {% comment %} Badge/Announcement {% endcomment %}
        {% if section.settings.announcement_text != blank %}
          <div class="hero-announcement">
            <span class="inline-flex items-center px-3 py-1 rounded-full bg-primary/10 text-primary text-sm font-medium border border-primary/20">
              {{ section.settings.announcement_text | escape }}
            </span>
          </div>
        {% endif %}

        {% comment %} Main Heading {% endcomment %}
        {% if section.settings.heading != blank %}
          <h1 class="text-4xl lg:text-5xl xl:text-6xl font-bold leading-tight text-base-content">
            {{ section.settings.heading | escape }}
          </h1>
        {% endif %}

        {% comment %} Subtitle {% endcomment %}
        {% if section.settings.subtitle != blank %}
          <div class="text-lg lg:text-xl text-base-content/80 leading-relaxed">
            {{ section.settings.subtitle | newline_to_br }}
          </div>
        {% endif %}

        {% comment %} Features List {% endcomment %}
        {% if section.settings.show_features and section.blocks.size > 0 %}
          <ul class="space-y-3">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'feature' %}
                  <li class="flex items-start gap-3">
                    <div class="flex-shrink-0 w-5 h-5 rounded-full bg-primary/20 flex items-center justify-center mt-0.5">
                      <svg class="w-3 h-3 text-primary" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                      </svg>
                    </div>
                    <span class="text-base-content/80">{{ block.settings.text | escape }}</span>
                  </li>
              {% endcase %}
            {% endfor %}
          </ul>
        {% endif %}

        {% comment %} Statistics {% endcomment %}
        {% if section.settings.show_stats %}
          <div class="flex flex-wrap gap-6 pt-4">
            {% if section.settings.stat_1_number %}
              <div class="stat-item">
                <div class="text-2xl lg:text-3xl font-bold text-primary">{{ section.settings.stat_1_number }}</div>
                <div class="text-sm text-base-content/60 uppercase tracking-wide">{{ section.settings.stat_1_label }}</div>
              </div>
            {% endif %}
            {% if section.settings.stat_2_number %}
              <div class="stat-item">
                <div class="text-2xl lg:text-3xl font-bold text-primary">{{ section.settings.stat_2_number }}</div>
                <div class="text-sm text-base-content/60 uppercase tracking-wide">{{ section.settings.stat_2_label }}</div>
              </div>
            {% endif %}
            {% if section.settings.stat_3_number %}
              <div class="stat-item">
                <div class="text-2xl lg:text-3xl font-bold text-primary">{{ section.settings.stat_3_number }}</div>
                <div class="text-sm text-base-content/60 uppercase tracking-wide">{{ section.settings.stat_3_label }}</div>
              </div>
            {% endif %}
          </div>
        {% endif %}

        {% comment %} CTA Buttons {% endcomment %}
        {% if section.settings.cta_primary_text != blank or section.settings.cta_secondary_text != blank %}
          <div class="hero-actions flex flex-wrap gap-4 pt-6">
            
            {% comment %} Primary CTA {% endcomment %}
            {% if section.settings.cta_primary_text != blank %}
              <a 
                href="{{ section.settings.cta_primary_url | default: '#' }}"
                class="btn btn-{{ section.settings.cta_primary_style | default: 'primary' }} btn-{{ section.settings.button_size | default: 'lg' }}"
                {% if section.settings.cta_primary_url contains 'http' %}target="_blank" rel="noopener"{% endif %}
                aria-label="{{ section.settings.cta_primary_text | escape }}"
              >
                {{ section.settings.cta_primary_text | escape }}
                {% if section.settings.show_arrow %}
                  <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                  </svg>
                {% endif %}
              </a>
            {% endif %}

            {% comment %} Secondary CTA {% endcomment %}
            {% if section.settings.cta_secondary_text != blank %}
              <a 
                href="{{ section.settings.cta_secondary_url | default: '#' }}"
                class="btn btn-{{ section.settings.cta_secondary_style | default: 'outline' }} btn-{{ section.settings.button_size | default: 'lg' }}"
                {% if section.settings.cta_secondary_url contains 'http' %}target="_blank" rel="noopener"{% endif %}
                aria-label="{{ section.settings.cta_secondary_text | escape }}"
              >
                {{ section.settings.cta_secondary_text | escape }}
              </a>
            {% endif %}
          </div>
        {% endif %}

        {% comment %} Social Proof {% endcomment %}
        {% if section.settings.show_social_proof %}
          <div class="social-proof pt-6 border-t border-base-content/10">
            {% if section.settings.social_proof_text %}
              <p class="text-sm text-base-content/60 mb-4">{{ section.settings.social_proof_text }}</p>
            {% endif %}
            {% if section.settings.customer_logos %}
              <div class="flex flex-wrap gap-4 items-center opacity-60">
                {% assign logos = section.settings.customer_logos | split: ',' %}
                {% for logo_url in logos %}
                  {% if forloop.index > 4 %}{% break %}{% endif %}
                  <img 
                    src="{{ logo_url | strip | image_url: width: 100 }}" 
                    alt="Customer logo"
                    class="h-6 w-auto grayscale hover:grayscale-0 transition-all"
                    width="100"
                    height="24"
                    loading="lazy"
                  >
                {% endfor %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>

    {% comment %} Image Side {% endcomment %}
    <div class="hero-image relative overflow-hidden {% if reverse_layout %}lg:col-start-1{% endif %}">
      {% if section.settings.hero_image %}
        <div class="w-full h-full {{ image_aspect }} lg:aspect-auto lg:h-full">
          <img 
            src="{{ section.settings.hero_image | image_url: width: 1000 }}"
            alt="{{ section.settings.hero_image.alt | default: section.settings.heading | escape }}"
            class="w-full h-full {{ image_position }} object-cover"
            width="1000"
            height="1000"
            {% if section.index == 1 %}loading="eager"{% else %}loading="lazy"{% endif %}
            sizes="(min-width: 1024px) 50vw, 100vw"
            srcset="
              {{ section.settings.hero_image | image_url: width: 500 }} 500w,
              {{ section.settings.hero_image | image_url: width: 750 }} 750w,
              {{ section.settings.hero_image | image_url: width: 1000 }} 1000w,
              {{ section.settings.hero_image | image_url: width: 1500 }} 1500w
            "
          >
        </div>
      {% else %}
        {% comment %} Default placeholder image {% endcomment %}
        <div class="w-full h-full {{ image_aspect }} lg:aspect-auto lg:h-full bg-gradient-to-br from-primary/10 via-secondary/5 to-accent/10 flex items-center justify-center">
          <div class="text-center text-base-content/30">
            <svg class="w-20 h-20 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            <div class="space-y-1">
              <div class="text-lg font-medium">{{ section.settings.heading | default: 'Hero Image' }}</div>
              <div class="text-sm opacity-60">Beautiful visuals to enhance your story</div>
            </div>
          </div>
        </div>
      {% endif %}

      {% comment %} Image Overlay Elements {% endcomment %}
      {% if section.settings.show_image_overlay %}
        <div class="absolute inset-0 bg-gradient-to-{{ section.settings.overlay_direction }} from-transparent to-black/20"></div>
      {% endif %}

      {% comment %} Floating Badge {% endcomment %}
      {% if section.settings.floating_badge_text != blank %}
        <div class="absolute top-6 left-6 bg-white/90 backdrop-blur-sm rounded-lg px-4 py-2 shadow-lg">
          <div class="text-sm font-semibold text-gray-900">{{ section.settings.floating_badge_text }}</div>
          {% if section.settings.floating_badge_subtext != blank %}
            <div class="text-xs text-gray-600">{{ section.settings.floating_badge_subtext }}</div>
          {% endif %}
        </div>
      {% endif %}

      {% comment %} Play Button Overlay (for video preview) {% endcomment %}
      {% if section.settings.show_play_button %}
        <div class="absolute inset-0 flex items-center justify-center">
          <button 
            class="btn btn-circle btn-lg bg-white/90 hover:bg-white border-0 text-primary shadow-xl"
            onclick="openVideoModal()"
            aria-label="Play video"
          >
            <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z"/>
            </svg>
          </button>
        </div>
      {% endif %}
    </div>
  </div>

  {% comment %} Decorative Elements {% endcomment %}
  {% if section.settings.show_decorative_dots %}
    <div class="absolute top-1/4 right-8 hidden lg:block">
      <div class="grid grid-cols-3 gap-2">
        {% for i in (1..9) %}
          <div class="w-2 h-2 rounded-full bg-primary/20"></div>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</section>

{% comment %} Video Modal (if play button is used) {% endcomment %}
{% if section.settings.show_play_button and section.settings.video_url %}
  <div id="videoModal" class="modal">
    <div class="modal-box max-w-4xl">
      <div class="aspect-video">
        <iframe 
          id="videoIframe"
          class="w-full h-full rounded-lg"
          src=""
          frameborder="0"
          allow="autoplay; encrypted-media"
          allowfullscreen
        ></iframe>
      </div>
      <div class="modal-action">
        <button class="btn" onclick="closeVideoModal()">Close</button>
      </div>
    </div>
    <div class="modal-backdrop" onclick="closeVideoModal()"></div>
  </div>

  <script>
    window.heroVideoUrl = {{ section.settings.video_url | json }};
  </script>
{% endif %}

{% comment %} Video Modal JavaScript - Must be outside conditional blocks {% endcomment %}
{% javascript %}
function openVideoModal() {
  const modal = document.getElementById('videoModal');
  const iframe = document.getElementById('videoIframe');
  const videoUrl = window.heroVideoUrl;
  
  if (!videoUrl) {
    console.warn('No video URL provided');
    return;
  }
  
  // Convert YouTube/Vimeo URLs to embed format
  let embedUrl = videoUrl;
  if (videoUrl.includes('youtube.com') || videoUrl.includes('youtu.be')) {
    const videoId = videoUrl.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([^&\n?#]+)/);
    if (videoId) {
      embedUrl = `https://www.youtube.com/embed/${videoId[1]}?autoplay=1`;
    }
  } else if (videoUrl.includes('vimeo.com')) {
    const videoId = videoUrl.match(/vimeo\.com\/(\d+)/);
    if (videoId) {
      embedUrl = `https://player.vimeo.com/video/${videoId[1]}?autoplay=1`;
    }
  }
  
  iframe.src = embedUrl;
  modal.classList.add('modal-open');
  document.body.style.overflow = 'hidden';
}

function closeVideoModal() {
  const modal = document.getElementById('videoModal');
  const iframe = document.getElementById('videoIframe');
  
  if (!modal || !iframe) return;
  
  iframe.src = '';
  modal.classList.remove('modal-open');
  document.body.style.overflow = '';
}
{% endjavascript %}

{% schema %}
{
  "name": "Hero - Split Layout",
  "tag": "section", 
  "class": "section-hero-split",
  "settings": [
    {
      "type": "header",
      "content": "Section Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "options": [
        {"value": "full", "label": "Full Page"},
        {"value": "container", "label": "Container"}
      ],
      "default": "full",
      "info": "Choose between full page width or contained layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding Right", 
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding Left",
      "default": 0
    },
    {
      "type": "header",
      "content": "Split Layout Settings"
    },
    {
      "type": "checkbox",
      "id": "reverse_layout",
      "label": "Image on Left",
      "default": false,
      "info": "By default, image appears on right side"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Section Height",
      "options": [
        {"value": "h-96", "label": "Small"},
        {"value": "min-h-screen", "label": "Full Screen"},
        {"value": "h-screen", "label": "Exact Screen Height"}
      ],
      "default": "min-h-screen"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content Alignment",
      "options": [
        {"value": "left", "label": "Left"},
        {"value": "center", "label": "Center"}
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "content_background_color",
      "label": "Content Background Color",
